{
  "action": {
    "default_popup": "popup.html"
  },
  "name": "",
  "short_name": "",
  "version": "",
  "manifest_version": 3,
  "description": "Essential Info for Forge of Empires addicts",
  "homepage_url": "https://foe-info.github.io/FoE-Info-Docs/",
  "browser_specific_settings": {
    "gecko": {
      "id": "foe-info@foe-info.github.io",
      "strict_min_version": "109.0"
    }
  },
  "devtools_page": "devtools.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/Icon16.png",
    "24": "icons/Icon24.png",
    "32": "icons/Icon32.png",
    "48": "icons/Icon48.png",
    "64": "icons/Icon64.png",
    "128": "icons/Icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.forgeofempires.com/game/*"],
      "js": ["browser-polyfill.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://*.forgeofempires.com/game/*",
    "wss://*.forgeofempires.com/*",
    "https://script.google.com/macros/s/*",
    "https://discord.com/api/webhooks/*",
    "https://*.innogamescdn.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["browser-polyfill.js"],
      "matches": ["https://*.forgeofempires.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' ; object-src 'self'"
  }
}
